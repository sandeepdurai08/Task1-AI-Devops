pipeline {
    agent any

    parameters {
        string(
            name: 'GITHUB_URL',
            defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git',
            description: 'GitHub repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'sandeep-08092026',
            description: 'Branch to build'
        )
    }

    tools {
        maven 'Maven 3'
        jdk   'JDK 11'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: "${params.GITHUB_URL}", branch: "${params.BRANCH}"
            }
        }

        stage('Build') {
            steps {
                dir('projects/maven-jar-project') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Verify JAR') {
            steps {
                dir('projects/maven-jar-project') {
                    bat 'dir target\\*.jar'
                }
            }
        }
    }

    post {
        success {
            echo "Maven JAR build succeeded! Branch: ${params.BRANCH}"
            archiveArtifacts artifacts: 'projects/maven-jar-project/target/*.jar', fingerprint: true
        }
        failure {
            echo "Maven JAR build failed. Branch: ${params.BRANCH}"
        }
    }
}
