pipeline {
    // agent any — restrict to a specific label in shared/production Jenkins
    // e.g. agent { label 'windows' }
    agent any

    parameters {
        // ── Source Control ────────────────────────────────────
        string(
            name: 'GITHUB_URL',
            defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git',
            description: 'GitHub repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'sandeep-08092026',
            description: 'Branch to build'
        )

        // ── SFTP Configuration ────────────────────────────────
        string(
            name: 'SFTP_HOST',
            defaultValue: 'sftp.example.com',
            description: 'SFTP server hostname'
        )
        string(
            name: 'SFTP_REMOTE_PATH',
            defaultValue: '/uploads/payment-system',
            description: 'SFTP remote base path (e.g. /uploads/payment-system)'
        )
        // SFTP_CREDENTIAL_ID: ID of a "Username with password" credential
        // stored in Jenkins Credentials Store — NOT the password itself.
        // To add: Manage Jenkins > Credentials > Global > Add Credentials
        //         Kind: Username with password
        //         ID:   sftp-credentials  (use this value below)
        string(
            name: 'SFTP_CREDENTIAL_ID',
            defaultValue: 'sftp-credentials',
            description: 'Jenkins Credential ID for SFTP (Username with password)'
        )

        // ── Module Toggles ────────────────────────────────────
        booleanParam(name: 'PAYMENT_GATEWAY',  defaultValue: true,  description: 'Enable Payment Gateway module')
        booleanParam(name: 'FRAUD_DETECTION',  defaultValue: true,  description: 'Enable Fraud Detection module')
        booleanParam(name: 'BILLING',          defaultValue: true,  description: 'Enable Billing module')
        booleanParam(name: 'REFUND',           defaultValue: true,  description: 'Enable Refund module')
        booleanParam(name: 'NOTIFICATION',     defaultValue: true,  description: 'Enable Notification module')
        booleanParam(name: 'AUTH',             defaultValue: true,  description: 'Enable Auth module')
        booleanParam(name: 'REPORTING',        defaultValue: true,  description: 'Enable Reporting module')
        booleanParam(name: 'SETTLEMENT',       defaultValue: true,  description: 'Enable Settlement module')
        booleanParam(name: 'RECONCILIATION',   defaultValue: false, description: 'Enable Reconciliation module')
        booleanParam(name: 'AUDIT',            defaultValue: false, description: 'Enable Audit module')
    }

    environment {
        DOTNET        = 'dotnet'
        BUILD_CONFIG  = 'Release'
        ARTIFACTS_DIR = 'artifacts'
    }

    stages {

        // ── Stage 1: Init ─────────────────────────────────────
        // Forces Jenkins to register ALL parameters on first run
        // so "Build with Parameters" shows all fields immediately
        stage('Init') {
            steps {
                script {
                    properties([
                        parameters([
                            string(name: 'GITHUB_URL',          defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git', description: 'GitHub repository URL'),
                            string(name: 'BRANCH',              defaultValue: 'sandeep-08092026',       description: 'Branch to build'),
                            string(name: 'SFTP_HOST',           defaultValue: 'sftp.example.com',        description: 'SFTP server hostname'),
                            string(name: 'SFTP_REMOTE_PATH',    defaultValue: '/uploads/payment-system', description: 'SFTP remote base path'),
                            string(name: 'SFTP_CREDENTIAL_ID',  defaultValue: 'sftp-credentials',        description: 'Jenkins Credential ID for SFTP (Username with password)'),
                            booleanParam(name: 'PAYMENT_GATEWAY',  defaultValue: true),
                            booleanParam(name: 'FRAUD_DETECTION',  defaultValue: true),
                            booleanParam(name: 'BILLING',          defaultValue: true),
                            booleanParam(name: 'REFUND',           defaultValue: true),
                            booleanParam(name: 'NOTIFICATION',     defaultValue: true),
                            booleanParam(name: 'AUTH',             defaultValue: true),
                            booleanParam(name: 'REPORTING',        defaultValue: true),
                            booleanParam(name: 'SETTLEMENT',       defaultValue: true),
                            booleanParam(name: 'RECONCILIATION',   defaultValue: false),
                            booleanParam(name: 'AUDIT',            defaultValue: false)
                        ])
                    ])
                    echo "All parameters registered."
                    echo "Branch : ${params.BRANCH}"
                    // [S1] Do NOT log SFTP_HOST or credential ID — avoids
                    //      exposing infrastructure details in the build log
                    echo "SFTP target configured."
                }
            }
        }

        // ── Stage 2: Validate Parameters ─────────────────────
        stage('Validate Parameters') {
            steps {
                script {
                    // [S2] URL must point to GitHub only
                    if (!params.GITHUB_URL?.startsWith('https://github.com/')) {
                        error "GITHUB_URL must start with https://github.com/"
                    }
                    // [S3] Branch — safe characters only, prevents shell injection
                    if (!params.BRANCH?.matches('[a-zA-Z0-9._/-]+')) {
                        error "BRANCH contains invalid characters."
                    }
                    // [S4] SFTP_REMOTE_PATH — absolute path, no traversal
                    if (!params.SFTP_REMOTE_PATH?.startsWith('/')) {
                        error "SFTP_REMOTE_PATH must be an absolute path starting with /"
                    }
                    if (params.SFTP_REMOTE_PATH?.contains('..')) {
                        error "SFTP_REMOTE_PATH must not contain '..' (directory traversal not allowed)"
                    }
                    // [S5] SFTP_HOST — safe hostname characters only
                    if (!params.SFTP_HOST?.matches('[a-zA-Z0-9._-]+')) {
                        error "SFTP_HOST contains invalid characters."
                    }
                    // [S6] SFTP_CREDENTIAL_ID — must be a non-empty safe identifier
                    if (!params.SFTP_CREDENTIAL_ID?.matches('[a-zA-Z0-9._-]+')) {
                        error "SFTP_CREDENTIAL_ID contains invalid characters."
                    }
                    // At least one module must be enabled
                    def moduleParams = [
                        'PAYMENT_GATEWAY', 'FRAUD_DETECTION', 'BILLING', 'REFUND',
                        'NOTIFICATION', 'AUTH', 'REPORTING', 'SETTLEMENT',
                        'RECONCILIATION', 'AUDIT'
                    ]
                    def anyEnabled = moduleParams.any { params[it] == true }
                    if (!anyEnabled) {
                        error "At least one module must be enabled before running the build."
                    }
                    echo "Validation passed."
                }
            }
        }

        // ── Stage 3: Checkout ─────────────────────────────────
        stage('Checkout') {
            steps {
                git url: "${params.GITHUB_URL}", branch: "${params.BRANCH}"
            }
        }

        // ── Stage 4: Build Modules ────────────────────────────
        stage('Build Modules') {
            steps {
                script {
                    // [paramName, folderName, dllName]
                    def modules = [
                        ['PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BILLING',          'Billing',         'Billing.dll'],
                        ['REFUND',           'Refund',          'Refund.dll'],
                        ['NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['AUTH',             'Auth',            'Auth.dll'],
                        ['REPORTING',        'Reporting',       'Reporting.dll'],
                        ['SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['AUDIT',            'Audit',           'Audit.dll']
                    ]

                    bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"

                    modules.each { mod ->
                        def paramName = mod[0]
                        def folder    = mod[1]

                        if (params[paramName]) {
                            echo "── Building: ${folder} ──"
                            bat "if not exist ${env.ARTIFACTS_DIR}\\${folder} mkdir ${env.ARTIFACTS_DIR}\\${folder}"
                            dir("projects/payment-system/modules/${folder}") {
                                bat "dotnet build ${folder}.csproj --configuration ${env.BUILD_CONFIG} --output ..\\..\\..\\..\\${env.ARTIFACTS_DIR}\\${folder} --nologo"
                            }
                            echo "✔ Built: ${folder}"
                        } else {
                            echo "── Skipped: ${folder} (disabled) ──"
                        }
                    }
                }
            }
        }

        // ── Stage 5: SFTP Upload ──────────────────────────────
        // [S7] Credentials are pulled from Jenkins Credentials Store using
        //      withCredentials — the password is NEVER written to the
        //      Jenkinsfile, build log, or parameter form.
        //      SFTP_USR and SFTP_PWD are masked automatically in all logs.
        //
        // Requires "Publish Over SSH" Jenkins plugin.
        // Configure server: Manage Jenkins > System > SSH Servers
        //   Name: SFTP_SERVER  Host: <your host>  Username: (from credential)
        stage('SFTP Upload') {
            steps {
                script {
                    def modules = [
                        ['PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BILLING',          'Billing',         'Billing.dll'],
                        ['REFUND',           'Refund',          'Refund.dll'],
                        ['NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['AUTH',             'Auth',            'Auth.dll'],
                        ['REPORTING',        'Reporting',       'Reporting.dll'],
                        ['SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['AUDIT',            'Audit',           'Audit.dll']
                    ]

                    // withCredentials binds the stored username + password into
                    // SFTP_USR and SFTP_PWD for the duration of this block only.
                    // Both variables are automatically masked (shown as ****)
                    // in all console output by the Credentials Binding plugin.
                    withCredentials([
                        usernamePassword(
                            credentialsId: params.SFTP_CREDENTIAL_ID,
                            usernameVariable: 'SFTP_USR',
                            passwordVariable: 'SFTP_PWD'
                        )
                    ]) {
                        modules.each { mod ->
                            def paramName = mod[0]
                            def folder    = mod[1]
                            def dll       = mod[2]

                            if (params[paramName]) {
                                sshPublisher(
                                    publishers: [
                                        sshPublisherDesc(
                                            configName: 'SFTP_SERVER',
                                            verbose: false,
                                            transfers: [
                                                sshTransfer(
                                                    sourceFiles:     "${env.ARTIFACTS_DIR}/${folder}/${dll}",
                                                    remoteDirectory: "${params.SFTP_REMOTE_PATH}/${folder}",
                                                    removePrefix:    "${env.ARTIFACTS_DIR}/${folder}"
                                                )
                                            ]
                                        )
                                    ]
                                )
                                echo "✔ Uploaded: ${folder}"
                            } else {
                                echo "── Skipped SFTP: ${folder} (disabled) ──"
                            }
                        }
                    } // end withCredentials — SFTP_USR and SFTP_PWD go out of scope here
                }
            }
        }

        // ── Stage 6: Artifact Report ──────────────────────────
        stage('Artifact Report') {
            steps {
                script {
                    def modules = [
                        ['PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BILLING',          'Billing',         'Billing.dll'],
                        ['REFUND',           'Refund',          'Refund.dll'],
                        ['NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['AUTH',             'Auth',            'Auth.dll'],
                        ['REPORTING',        'Reporting',       'Reporting.dll'],
                        ['SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['AUDIT',            'Audit',           'Audit.dll']
                    ]

                    // [S8] Sanitise user-supplied params before injecting into HTML
                    //      to prevent XSS via malicious BRANCH or SFTP_REMOTE_PATH values
                    def safeBranch   = params.BRANCH.replaceAll('[<>&"\']', '')
                    def safeSftpHost = params.SFTP_HOST.replaceAll('[<>&"\']', '')
                    def safeSftpPath = params.SFTP_REMOTE_PATH.replaceAll('[<>&"\']', '')

                    def report = """
<b>Payment System &mdash; Build Report</b><br/>
<b>Branch:</b> ${safeBranch} &nbsp;|&nbsp;
<b>Build:</b> #${env.BUILD_NUMBER} &nbsp;|&nbsp;
<b>SFTP Host:</b> ${safeSftpHost}<br/><br/>
<table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-family:monospace;font-size:12px;'>
  <tr style='background:#333;color:#fff;'>
    <th>Module</th>
    <th>Status</th>
    <th>DLL Location (Local)</th>
    <th>SFTP Path</th>
  </tr>
"""
                    modules.each { mod ->
                        def paramName = mod[0]
                        def folder    = mod[1]
                        def dll       = mod[2]

                        if (params[paramName]) {
                            def dllPath  = "${env.WORKSPACE}\\${env.ARTIFACTS_DIR}\\${folder}\\${dll}"
                            def sftpPath = "${safeSftpPath}/${folder}/${dll}"
                            report += """  <tr>
    <td><b>${folder}</b></td>
    <td style='color:green;'>&#10004; Built &amp; Uploaded</td>
    <td><code>${dllPath}</code></td>
    <td><code>${sftpPath}</code></td>
  </tr>
"""
                        } else {
                            report += """  <tr style='color:#999;'>
    <td>${folder}</td>
    <td>&#8212; Skipped</td>
    <td>&#8212;</td>
    <td>&#8212;</td>
  </tr>
"""
                        }
                    }

                    report += "</table>"
                    currentBuild.description = report
                    echo "Artifact report written to build description."
                }
            }
        }
    }

    post {
        success {
            echo "Payment System build completed successfully. Branch: ${params.BRANCH}"
            archiveArtifacts artifacts: 'artifacts/**/*.dll', fingerprint: true, allowEmptyArchive: false
        }
        failure {
            echo "Payment System build FAILED. Branch: ${params.BRANCH}"
            script {
                currentBuild.description = "<b style='color:red;'>BUILD FAILED</b> — Branch: ${params.BRANCH} | Build: #${env.BUILD_NUMBER}"
            }
        }
    }
}
