pipeline {
    // agent any — restrict to a specific label in shared/production Jenkins
    // e.g. agent { label 'windows' }
    agent any

    parameters {
        // ── Source Control ────────────────────────────────────
        string(
            name: 'GITHUB_URL',
            defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git',
            description: 'GitHub repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'sandeep-08092026',
            description: 'Branch to build'
        )

        // ── SFTP Configuration ────────────────────────────────
        string(
            name: 'SFTP_HOST',
            defaultValue: 'sftp.example.com',
            description: 'SFTP server hostname'
        )
        string(
            name: 'SFTP_USER',
            defaultValue: 'sftp-user',
            description: 'SFTP username'
        )
        string(
            name: 'SFTP_REMOTE_PATH',
            defaultValue: '/uploads/payment-system',
            description: 'SFTP remote base path (e.g. /uploads/payment-system)'
        )

        // ── Module Toggles ────────────────────────────────────
        booleanParam(name: 'BUILD_PAYMENT_GATEWAY',  defaultValue: true,  description: 'Build Payment Gateway module')
        booleanParam(name: 'BUILD_FRAUD_DETECTION',  defaultValue: true,  description: 'Build Fraud Detection module')
        booleanParam(name: 'BUILD_BILLING',          defaultValue: true,  description: 'Build Billing module')
        booleanParam(name: 'BUILD_REFUND',           defaultValue: true,  description: 'Build Refund module')
        booleanParam(name: 'BUILD_NOTIFICATION',     defaultValue: true,  description: 'Build Notification module')
        booleanParam(name: 'BUILD_AUTH',             defaultValue: true,  description: 'Build Auth module')
        booleanParam(name: 'BUILD_REPORTING',        defaultValue: true,  description: 'Build Reporting module')
        booleanParam(name: 'BUILD_SETTLEMENT',       defaultValue: true,  description: 'Build Settlement module')
        booleanParam(name: 'BUILD_RECONCILIATION',   defaultValue: false, description: 'Build Reconciliation module')
        booleanParam(name: 'BUILD_AUDIT',            defaultValue: false, description: 'Build Audit module')
    }

    environment {
        DOTNET        = 'dotnet'
        BUILD_CONFIG  = 'Release'
        ARTIFACTS_DIR = 'artifacts'
    }

    stages {

        // ── Stage 1: Init ─────────────────────────────────────
        // Forces Jenkins to register ALL parameters on first run
        // so "Build with Parameters" shows all 15 fields immediately
        stage('Init') {
            steps {
                script {
                    properties([
                        parameters([
                            string(name: 'GITHUB_URL',       defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git', description: 'GitHub repository URL'),
                            string(name: 'BRANCH',           defaultValue: 'sandeep-08092026',        description: 'Branch to build'),
                            string(name: 'SFTP_HOST',        defaultValue: 'sftp.example.com',         description: 'SFTP server hostname'),
                            string(name: 'SFTP_USER',        defaultValue: 'sftp-user',                description: 'SFTP username'),
                            string(name: 'SFTP_REMOTE_PATH', defaultValue: '/uploads/payment-system',  description: 'SFTP remote base path'),
                            booleanParam(name: 'BUILD_PAYMENT_GATEWAY',  defaultValue: true),
                            booleanParam(name: 'BUILD_FRAUD_DETECTION',  defaultValue: true),
                            booleanParam(name: 'BUILD_BILLING',          defaultValue: true),
                            booleanParam(name: 'BUILD_REFUND',           defaultValue: true),
                            booleanParam(name: 'BUILD_NOTIFICATION',     defaultValue: true),
                            booleanParam(name: 'BUILD_AUTH',             defaultValue: true),
                            booleanParam(name: 'BUILD_REPORTING',        defaultValue: true),
                            booleanParam(name: 'BUILD_SETTLEMENT',       defaultValue: true),
                            booleanParam(name: 'BUILD_RECONCILIATION',   defaultValue: false),
                            booleanParam(name: 'BUILD_AUDIT',            defaultValue: false)
                        ])
                    ])
                    echo "All parameters registered."
                    echo "Branch : ${params.BRANCH}"
                    // [S1] Do NOT log SFTP_USER or SFTP_HOST — avoids exposing
                    //      infrastructure details in the build log
                    echo "SFTP target configured."
                }
            }
        }

        // ── Stage 2: Validate Parameters ─────────────────────
        stage('Validate Parameters') {
            steps {
                script {
                    // [S2] URL must point to GitHub only — prevents redirecting
                    //      checkout to a malicious external repo
                    if (!params.GITHUB_URL?.startsWith('https://github.com/')) {
                        error "GITHUB_URL must start with https://github.com/"
                    }
                    // [S3] Branch must contain only safe characters — prevents
                    //      shell injection via branch name (e.g. '; rm -rf /')
                    if (!params.BRANCH?.matches('[a-zA-Z0-9._/-]+')) {
                        error "BRANCH contains invalid characters."
                    }
                    // [S4] SFTP_REMOTE_PATH must be an absolute path starting
                    //      with / — prevents directory traversal attacks
                    if (!params.SFTP_REMOTE_PATH?.startsWith('/')) {
                        error "SFTP_REMOTE_PATH must be an absolute path starting with /"
                    }
                    if (params.SFTP_REMOTE_PATH?.contains('..')) {
                        error "SFTP_REMOTE_PATH must not contain '..' (directory traversal not allowed)"
                    }
                    // [S5] SFTP_HOST must not be empty or contain shell-special chars
                    if (!params.SFTP_HOST?.matches('[a-zA-Z0-9._-]+')) {
                        error "SFTP_HOST contains invalid characters."
                    }
                    // At least one module must be enabled
                    def moduleParams = [
                        'BUILD_PAYMENT_GATEWAY', 'BUILD_FRAUD_DETECTION', 'BUILD_BILLING',
                        'BUILD_REFUND', 'BUILD_NOTIFICATION', 'BUILD_AUTH',
                        'BUILD_REPORTING', 'BUILD_SETTLEMENT', 'BUILD_RECONCILIATION', 'BUILD_AUDIT'
                    ]
                    def anyEnabled = moduleParams.any { params[it] == true }
                    if (!anyEnabled) {
                        error "At least one module must be enabled before running the build."
                    }
                    echo "Validation passed."
                }
            }
        }

        // ── Stage 3: Checkout ─────────────────────────────────
        stage('Checkout') {
            steps {
                git url: "${params.GITHUB_URL}", branch: "${params.BRANCH}"
            }
        }

        // ── Stage 4: Build Modules ────────────────────────────
        // Only builds modules whose toggle is enabled
        stage('Build Modules') {
            steps {
                script {
                    // [paramName, folderName, dllName]
                    def modules = [
                        ['BUILD_PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['BUILD_FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BUILD_BILLING',          'Billing',         'Billing.dll'],
                        ['BUILD_REFUND',           'Refund',          'Refund.dll'],
                        ['BUILD_NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['BUILD_AUTH',             'Auth',            'Auth.dll'],
                        ['BUILD_REPORTING',        'Reporting',       'Reporting.dll'],
                        ['BUILD_SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['BUILD_RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['BUILD_AUDIT',            'Audit',           'Audit.dll']
                    ]

                    // Create root artifacts folder
                    bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"

                    modules.each { mod ->
                        def paramName = mod[0]
                        def folder    = mod[1]

                        if (params[paramName]) {
                            echo "── Building: ${folder} ──"
                            bat "if not exist ${env.ARTIFACTS_DIR}\\${folder} mkdir ${env.ARTIFACTS_DIR}\\${folder}"
                            dir("projects/payment-system/modules/${folder}") {
                                bat "dotnet build ${folder}.csproj --configuration ${env.BUILD_CONFIG} --output ..\\..\\..\\..\\${env.ARTIFACTS_DIR}\\${folder} --nologo"
                            }
                            echo "✔ Built: ${folder}"
                        } else {
                            echo "── Skipped: ${folder} (disabled) ──"
                        }
                    }
                }
            }
        }

        // ── Stage 5: SFTP Upload ──────────────────────────────
        // Requires "Publish Over SSH" Jenkins plugin
        // Configure server in: Manage Jenkins > System > SSH Servers
        // Server must be named exactly: SFTP_SERVER
        // [S6] SFTP credentials (password/key) must be stored in Jenkins
        //      credential store — NEVER passed as pipeline parameters
        stage('SFTP Upload') {
            steps {
                script {
                    def modules = [
                        ['BUILD_PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['BUILD_FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BUILD_BILLING',          'Billing',         'Billing.dll'],
                        ['BUILD_REFUND',           'Refund',          'Refund.dll'],
                        ['BUILD_NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['BUILD_AUTH',             'Auth',            'Auth.dll'],
                        ['BUILD_REPORTING',        'Reporting',       'Reporting.dll'],
                        ['BUILD_SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['BUILD_RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['BUILD_AUDIT',            'Audit',           'Audit.dll']
                    ]

                    modules.each { mod ->
                        def paramName = mod[0]
                        def folder    = mod[1]
                        def dll       = mod[2]

                        if (params[paramName]) {
                            // [S7] Do NOT log SFTP paths in plain echo — use
                            //      verbose:true on sshPublisher only for debug builds
                            sshPublisher(
                                publishers: [
                                    sshPublisherDesc(
                                        configName: 'SFTP_SERVER',
                                        verbose: false,
                                        transfers: [
                                            sshTransfer(
                                                sourceFiles:     "${env.ARTIFACTS_DIR}/${folder}/${dll}",
                                                remoteDirectory: "${params.SFTP_REMOTE_PATH}/${folder}",
                                                removePrefix:    "${env.ARTIFACTS_DIR}/${folder}"
                                            )
                                        ]
                                    )
                                ]
                            )
                            echo "✔ Uploaded: ${folder}"
                        } else {
                            echo "── Skipped SFTP: ${folder} (disabled) ──"
                        }
                    }
                }
            }
        }

        // ── Stage 6: Artifact Report ──────────────────────────
        // Sets Jenkins build description to an HTML table showing:
        // Module | Status | DLL local path | SFTP remote path
        stage('Artifact Report') {
            steps {
                script {
                    def modules = [
                        ['BUILD_PAYMENT_GATEWAY',  'PaymentGateway',  'PaymentGateway.dll'],
                        ['BUILD_FRAUD_DETECTION',  'FraudDetection',  'FraudDetection.dll'],
                        ['BUILD_BILLING',          'Billing',         'Billing.dll'],
                        ['BUILD_REFUND',           'Refund',          'Refund.dll'],
                        ['BUILD_NOTIFICATION',     'Notification',    'Notification.dll'],
                        ['BUILD_AUTH',             'Auth',            'Auth.dll'],
                        ['BUILD_REPORTING',        'Reporting',       'Reporting.dll'],
                        ['BUILD_SETTLEMENT',       'Settlement',      'Settlement.dll'],
                        ['BUILD_RECONCILIATION',   'Reconciliation',  'Reconciliation.dll'],
                        ['BUILD_AUDIT',            'Audit',           'Audit.dll']
                    ]

                    // [S8] Sanitise any user-supplied string inserted into HTML
                    //      to prevent XSS via malicious BRANCH or SFTP_REMOTE_PATH values
                    def safeBranch   = params.BRANCH.replaceAll('[<>&"\']', '')
                    def safeSftpHost = params.SFTP_HOST.replaceAll('[<>&"\']', '')
                    def safeSftpPath = params.SFTP_REMOTE_PATH.replaceAll('[<>&"\']', '')

                    def report = """
<b>Payment System &mdash; Build Report</b><br/>
<b>Branch:</b> ${safeBranch} &nbsp;|&nbsp;
<b>Build:</b> #${env.BUILD_NUMBER} &nbsp;|&nbsp;
<b>SFTP Host:</b> ${safeSftpHost}<br/><br/>
<table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;font-family:monospace;font-size:12px;'>
  <tr style='background:#333;color:#fff;'>
    <th>Module</th>
    <th>Status</th>
    <th>DLL Location (Local)</th>
    <th>SFTP Path</th>
  </tr>
"""
                    modules.each { mod ->
                        def paramName = mod[0]
                        def folder    = mod[1]
                        def dll       = mod[2]

                        if (params[paramName]) {
                            def dllPath  = "${env.WORKSPACE}\\${env.ARTIFACTS_DIR}\\${folder}\\${dll}"
                            def sftpPath = "${safeSftpPath}/${folder}/${dll}"
                            report += """  <tr>
    <td><b>${folder}</b></td>
    <td style='color:green;'>&#10004; Built &amp; Uploaded</td>
    <td><code>${dllPath}</code></td>
    <td><code>${sftpPath}</code></td>
  </tr>
"""
                        } else {
                            report += """  <tr style='color:#999;'>
    <td>${folder}</td>
    <td>&#8212; Skipped</td>
    <td>&#8212;</td>
    <td>&#8212;</td>
  </tr>
"""
                        }
                    }

                    report += "</table>"
                    currentBuild.description = report
                    echo "Artifact report written to build description."
                }
            }
        }
    }

    post {
        success {
            echo "Payment System build completed successfully. Branch: ${params.BRANCH}"
            archiveArtifacts artifacts: 'artifacts/**/*.dll', fingerprint: true, allowEmptyArchive: false
        }
        failure {
            echo "Payment System build FAILED. Branch: ${params.BRANCH}"
            // Clear any partial description so failure is obvious
            script {
                currentBuild.description = "<b style='color:red;'>BUILD FAILED</b> — Branch: ${params.BRANCH} | Build: #${env.BUILD_NUMBER}"
            }
        }
    }
}
