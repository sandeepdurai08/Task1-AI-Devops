pipeline {
    // agent any — restrict to a specific label in shared/production Jenkins
    // e.g. agent { label 'windows' }
    agent any

    parameters {
        string(
            name: 'GITHUB_URL',
            defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git',
            description: 'GitHub repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'sandeep-08092026',
            description: 'Branch to build'
        )
    }

    environment {
        DOTNET = 'dotnet'
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.GITHUB_URL?.startsWith('https://github.com/')) {
                        error "GITHUB_URL must start with https://github.com/ — got: ${params.GITHUB_URL}"
                    }
                    if (!params.BRANCH?.matches('[a-zA-Z0-9._/-]+')) {
                        error "BRANCH contains invalid characters: ${params.BRANCH}"
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: "${params.GITHUB_URL}", branch: "${params.BRANCH}"
            }
        }

        stage('Restore') {
            steps {
                dir('projects/dotnet-console-app') {
                    bat '%DOTNET% restore HelloApp.sln'
                }
            }
        }

        stage('Build') {
            steps {
                dir('projects/dotnet-console-app') {
                    bat '%DOTNET% build HelloApp.sln --configuration Release --no-restore'
                }
            }
        }

        stage('Run App') {
            steps {
                dir('projects/dotnet-console-app') {
                    bat '%DOTNET% run --project HelloApp\\HelloApp.csproj --configuration Release'
                }
            }
        }

        stage('Publish') {
            steps {
                dir('projects/dotnet-console-app') {
                    bat '%DOTNET% publish HelloApp\\HelloApp.csproj --configuration Release --output publish\\'
                }
            }
        }
    }

    post {
        success {
            echo ".NET Console App build succeeded! Branch: ${params.BRANCH}"
            archiveArtifacts artifacts: 'projects/dotnet-console-app/publish/**/*',
                             fingerprint: true
        }
        failure {
            echo ".NET Console App build failed. Branch: ${params.BRANCH}"
        }
    }
}
