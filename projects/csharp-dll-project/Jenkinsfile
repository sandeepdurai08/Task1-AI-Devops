pipeline {
    agent any

    parameters {
        string(
            name: 'GITHUB_URL',
            defaultValue: 'https://github.com/sandeepdurai08/Task1-AI-Devops.git',
            description: 'GitHub repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'sandeep-08092026',
            description: 'Branch to build'
        )
    }

    environment {
        DOTNET = 'dotnet'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: "${params.GITHUB_URL}", branch: "${params.BRANCH}"
            }
        }

        stage('Restore') {
            steps {
                dir('projects/csharp-dll-project') {
                    bat '%DOTNET% restore MathLibrary.sln'
                }
            }
        }

        stage('Build') {
            steps {
                dir('projects/csharp-dll-project') {
                    bat '%DOTNET% build MathLibrary.sln --configuration Release --no-restore'
                }
            }
        }

        stage('Verify DLL') {
            steps {
                dir('projects/csharp-dll-project') {
                    bat 'dir MathLibrary\\bin\\Release\\net10.0\\*.dll'
                }
            }
        }
    }

    post {
        success {
            echo "C# DLL build succeeded! Branch: ${params.BRANCH}"
            archiveArtifacts artifacts: 'projects/csharp-dll-project/MathLibrary/bin/Release/net10.0/*.dll',
                             fingerprint: true
        }
        failure {
            echo "C# DLL build failed. Branch: ${params.BRANCH}"
        }
    }
}
