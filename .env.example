# ===========================================
# JENKINS CHATBOT - CONFIGURATION FILE
# ===========================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ===========================================


# -------------------------------------------
# JENKINS CONFIGURATION
# -------------------------------------------
# Your Jenkins server URL (no trailing slash)
JENKINS_URL=http://your-jenkins-server:8080

# Your Jenkins username
JENKINS_USER=your-username

# Jenkins API Token
# Generate from: Jenkins > Click your name > Configure > API Token > Add new Token
JENKINS_API_TOKEN=your-api-token-here


# -------------------------------------------
# OLLAMA CONFIGURATION  
# -------------------------------------------
# Ollama server URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model to use - make sure it's pulled first: ollama pull llama3
OLLAMA_MODEL=llama3


# -------------------------------------------
# GOOGLE CHAT CONFIGURATION
# -------------------------------------------
# Your Google Cloud Project Number (NOT project ID!)
# Find it: Google Cloud Console > Your Project > Dashboard > Project Number
GOOGLE_CHAT_PROJECT_NUMBER=123456789012

# Enable/disable token verification (set to false only for testing)
VERIFY_GOOGLE_TOKEN=true


# -------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------
# Port for the Flask server
PORT=5000

# Enable debug mode (set to false in production)
FLASK_DEBUG=false
