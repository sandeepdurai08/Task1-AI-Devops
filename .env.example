# ─── LLM ───────────────────────────────────────────────────────────────────────
LLM_URL=https://exterrollm.exterrocloud.info/v1/chat/completions
LLM_MODEL=/exterro/services/models/Qwen3-30B-A3B-Instruct-2507
# Leave as "none" if the internal endpoint does not require an API key
LLM_API_KEY=none
# Set to false to skip TLS certificate verification (e.g. self-signed internal certs)
LLM_VERIFY_SSL=true

# ─── Jenkins ────────────────────────────────────────────────────────────────────
# ADMIN-CONFIGURED — set these once, not overridable from chat
JENKINS_URL=http://localhost:8080
JENKINS_USER=your_jenkins_username
JENKINS_TOKEN=your_jenkins_api_token     # NOT your password — generate in Jenkins

# JENKINS_JOBS — optional security allowlist (comma-separated job names).
# Leave empty to allow ALL jobs visible to JENKINS_USER.
# Recommended for production: explicitly list the jobs BuildBot is allowed to trigger.
# Example: JENKINS_JOBS=hotfix-build,release-build,nightly-build
JENKINS_JOBS=

# ─── Defaults (DEV-OVERRIDABLE via chat) ────────────────────────────────────────
# These are fallback values. A developer can override them by mentioning a
# different URL or branch in the chat message.
DEFAULT_REPO_URL=
DEFAULT_BRANCH=

# ─── Artifacts ──────────────────────────────────────────────────────────────────
# ADMIN-CONFIGURED — local folder where build artifacts are copied after a build
ARTIFACT_SHARE=C:\shared\builds

# ─── Google Chat ────────────────────────────────────────────────────────────────
# ADMIN-CONFIGURED — incoming webhook URL for the DevOps AI Challenge space
GCHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/.../messages?key=...

# ─── Email (MailHog local SMTP — see README for setup) ──────────────────────────
# ADMIN-CONFIGURED — MailHog listens on localhost:1025 by default
SMTP_HOST=localhost
SMTP_PORT=1025
NOTIFY_EMAIL_FROM=buildbot@local
NOTIFY_EMAIL_TO=dev@local

# ─── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace-with-a-random-secret-string

# ─── Auth ───────────────────────────────────────────────────────────────────────
# AUTH_ENABLED=true   → login required
# AUTH_ENABLED=false  → no login (dev/single-user mode)
AUTH_ENABLED=true

# AUTH_MODE=jenkins   → log in with Jenkins username + password/API token (recommended)
# AUTH_MODE=local     → log in with accounts from config/users.json only
AUTH_MODE=jenkins

# AUTH_FALLBACK=true  → users.json admin accounts always work, even in jenkins mode
#                        (emergency access when Jenkins is unreachable)
AUTH_FALLBACK=true
